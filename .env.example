# Copy to .env for local work. On Vercel, set these under
# Settings -> Environment Variables instead — .env is gitignored and never
# reaches the deployment.

# Base URL of the backend API. A bare host:port works (lib/base-path.ts fills
# in the scheme), but the full URL is clearer. Only ever read on the server,
# so it does not need the NEXT_PUBLIC_ prefix.
API_URL=http://3.107.247.137:8081

# Signs the session cookie. Required in production — the app throws rather
# than fall back to the built-in development secret, which anyone reading the
# source could use to mint their own sessions.
#
# Generate one with either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it later invalidates every existing session, signing everyone out.
SESSION_SECRET=
